# Where the app reads the WordPress REST API (server-side only).
# Today that is the live site; after the domain switch, the CMS host
# (e.g. https://cms.apex-idaho.com).
WORDPRESS_URL=https://apex-idaho.com

# Where visitors are sent for pages WordPress keeps serving: cart, checkout,
# ticket purchase, account and forms. Defaults to WORDPRESS_URL.
# WORDPRESS_PUBLIC_URL=https://cms.apex-idaho.com

# This site's public URL, for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with WordPress (APEX_HEADLESS_REVALIDATE_SECRET in wp-config.php).
# WordPress calls POST /api/revalidate with it when content changes.
REVALIDATE_SECRET=change-me

# Seconds before cached WordPress data is refreshed in the background, as a
# backstop to the webhook. Default 300.
# REVALIDATE_SECONDS=300
