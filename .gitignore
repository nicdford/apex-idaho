# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore
# Paths anchored under apps/wordpress/ since the WP install was moved there.

# Core
/apps/wordpress/wp-admin/
/apps/wordpress/wp-content/index.php
/apps/wordpress/wp-content/languages
/apps/wordpress/wp-content/plugins/index.php
/apps/wordpress/wp-content/themes/index.php
/apps/wordpress/wp-includes/
/apps/wordpress/index.php
/apps/wordpress/license.txt
/apps/wordpress/readme.html
/apps/wordpress/wp-*.php
/apps/wordpress/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/apps/wordpress/wp-content/themes/twenty*/

# Example plugin
/apps/wordpress/wp-content/plugins/hello.php

# Uploads
/apps/wordpress/wp-content/uploads/

# Log files
*.log

# htaccess
/apps/wordpress/.htaccess

# Composer vendor directories
/apps/wordpress/wp-content/themes/bb-theme-child/vendor/

# Local symlink that links the attendee-api source into the WP plugins dir for local dev.
# Created by apps/wordpress/start-dev.sh; never committed.
/apps/wordpress/wp-content/plugins/attendee-api

# Bot build artifacts
/apps/discord-bot/node_modules/
/apps/discord-bot/dist/

.ds_store
.env
/scripts/.deploy.env
