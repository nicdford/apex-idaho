{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Hot",
	"slug": "section-hot",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover" ],
	"styles": {
		"color": {
			"gradient": "var:preset|gradient|apex",
			"text": "var:preset|color|carbon"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|carbon" },
				":hover": { "color": { "text": "var:preset|color|carbon" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|carbon" }
			},
			"button": {
				"color": { "text": "var:preset|color|chalk", "background": "var:preset|color|carbon", "gradient": "none" },
				":hover": { "color": { "text": "var:preset|color|carbon", "background": "var:preset|color|white", "gradient": "none" } },
				":focus": { "color": { "text": "var:preset|color|carbon", "background": "var:preset|color|white", "gradient": "none" } }
			}
		}
	}
}
